{
  "name": "sdc-spec",
  "version": "1.3.0",
  "description": "SDC is a lightweight spec-driven coding workflow for Claude Code and Codex: requirement and knowledge governance, artifact contracts, execution orchestration, review-gated delivery, legacy impact analysis, and knowledge compaction.",
  "engines": {
    "node": ">=14.0.0"
  },
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit-release.mjs",
    "eval:sdc": "python3 evals/sdc-flow/run_sdc_flow.py",
    "eval:agents": "python3 evals/sdc-agent/run_agent_evals.py",
    "test": "python3 -m unittest discover -s evals -p 'test_*.py'",
    "package:codex": "python3 scripts/package-codex-plugin.py",
    "sync:skills": "node bin/install.js sync-public-skills"
  },
  "bin": {
    "sdc": "bin/sdc.js",
    "sdc-spec": "bin/install.js",
    "sdc-cli": "sdc-cli.py"
  },
  "files": [
    "bin/",
    "commands/",
    "evals/sdc-flow/README.md",
    "evals/sdc-flow/promptfooconfig.yaml",
    "evals/sdc-flow/run_sdc_flow.py",
    "evals/sdc-flow/sdc_flow_provider.py",
    "evals/sdc-agent/",
    "hooks/",
    "scripts/audit-release.mjs",
    "scripts/package-codex-plugin.py",
    "scripts/sdc-review-package.py",
    "scripts/sdc-runtime-context.py",
    "scripts/sdc_evidence.py",
    "scripts/sdc_compact.py",
    "scripts/sdc_findings.py",
    "scripts/sdc-doctor.mjs",
    "scripts/sdc-task-brief.py",
    "skills/",
    "sdc-references/",
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "docs/claude-code-marketplace.md",
    "docs/official-submission.md",
    "docs/release-checklist.md",
    "docs/sdc-discipline-core.md",
    "SECURITY.md",
    "PRIVACY.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "sdc",
    "sdc-core",
    "sdc-check",
    "sdc-init",
    "sdc-change",
    "sdc-apply",
    "sdc-validate",
